{
  "compilerOptions": {
    "lib": ["DOM", "ES2017"],
    "jsx": "react",
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "remotion.config.ts"]
}
